{
  // The shared preset holds grouping, automerge and digest pinning. Only this repo's rules are below.
  // The cron in .github/workflows/renovate.yaml sets the cadence, so workflow_dispatch works too.
  // A merged bump rebuilds the image on main. A bad bump shows as a red build there, never as a release.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>yama6a/gha:default.json5"],

  prConcurrentLimit: 6,

  customManagers: [
    {
      // Images annotated `# renovate: datasource=docker`, which no built-in manager reads. Bumps tag and digest.
      customType: "regex",
      description: "docker image refs (annotated) in versions.env and lib/*.sh",
      managerFilePatterns: ["/^versions\\.env$/", "/^lib/.*\\.sh$/"],
      matchStrings: [
        "# renovate: datasource=docker(?: versioning=(?<versioning>\\S+))?\\s+[^\\n]*?(?<depName>[a-z0-9][a-z0-9._/-]+):(?<currentValue>[\\w][\\w.-]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?",
      ],
      datasourceTemplate: "docker",
    },
    {
      // versions.env scalars with a full `# renovate:` annotation. SBCOVERLAY_VERSION is below.
      customType: "regex",
      description: "annotated version scalars in versions.env",
      managerFilePatterns: ["/^versions\\.env$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+\\w+=\"(?<currentValue>[^\"]+)\"",
      ],
    },
    {
      // A bare commit SHA, because the repo has no tags. Tracks main's HEAD.
      customType: "regex",
      description: "sbc-raspberrypi5 overlay commit pin",
      managerFilePatterns: ["/^versions\\.env$/"],
      matchStrings: ["SBCOVERLAY_VERSION=\"(?<currentDigest>[a-f0-9]{40})\""],
      currentValueTemplate: "main",
      depNameTemplate: "talos-rpi5/sbc-raspberrypi5",
      packageNameTemplate: "https://github.com/talos-rpi5/sbc-raspberrypi5",
      datasourceTemplate: "git-refs",
    },
  ],

  packageRules: [
    {
      // A Talos minor or major can move the kernel, pkgs, the stock config and the overlay API at once.
      // Preflight proves only part of that, so a person reviews it.
      description: "Talos minor and major: reviewed alone against docs/runbooks/upgrade.md",
      matchDepNames: ["siderolabs/talos"],
      matchUpdateTypes: ["major", "minor"],
      groupName: null, // out of the combined group, or it blocks that PR's automerge
      automerge: false,
      addLabels: ["needs-review"],
    },
  ],
}
