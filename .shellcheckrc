disable=SC2034   # "variable appears unused": the scripts that source lib/common.sh read its constants
disable=SC1091   # "not following sourced file": common.sh comes from a computed path, so shellcheck cannot find it
disable=SC2015   # "A && B || C is not if-then-else": `cond && ok || err` is how every script reports a check
disable=SC2016   # "expressions do not expand in single quotes": those bodies run in a container or a remote shell
