disable=SC2034   # lib/common.sh constants (KERNEL_*, IMAGE_*, PKGS_*, MACHINERY_VERSION) are read by the scripts that source it
disable=SC1091   # common.sh is sourced via a computed path; shellcheck cannot follow it and -x does not help
disable=SC2015   # `cond && ok || err` is the deliberate reporting idiom, not an if-then-else mistake
disable=SC2016   # single-quoted bodies are templates evaluated elsewhere (in-container or remote shell)
