# The committed version recipe, sourced by lib/common.sh. To bump: edit here, or let renovate do it
# (renovate.json5 customManagers). A merged bump pushes to main, which is what triggers a rebuild.
#
# Deliberately absent: the kernel and siderolabs/pkgs. Both are DERIVED from TALOS_VERSION at build time by
# lib/resolve_inputs.sh, so they cannot drift out of step with the Talos release. See docs/kernel.md.

## The Talos release everything else is rebased onto.
# renovate: datasource=github-releases depName=siderolabs/talos
TALOS_VERSION="v1.13.8"

## The Pi 5 boot chain (u-boot, dtbs, config.txt). A bare commit SHA: the repo has no tags.
SBCOVERLAY_VERSION="7d04484be2beb4b1fca56538d2b6d07e7d58681f"

## Digest-pinned system extensions baked into the installer.
# renovate: datasource=docker
ISCSI_EXT="ghcr.io/siderolabs/iscsi-tools:v0.2.0@sha256:8617f0503e0f2289322fa376e08a8609df7b9cf4f79876b88c544e90e5bcf606"
# renovate: datasource=docker
UTIL_EXT="ghcr.io/siderolabs/util-linux-tools:2.42.2@sha256:b5f90c0b4904f09e9740e9a19970628832e531a7be40644a8f2dd18fa8336408"
