# The version recipe. Renovate bumps it, and a merged bump rebuilds the image.
# No kernel or pkgs pin: lib/resolve_inputs.sh derives both from TALOS_VERSION. See docs/kernel.md.

## The Talos release everything else is rebased onto.
# renovate: datasource=github-releases depName=siderolabs/talos
TALOS_VERSION="v1.14.5"

## The Pi 5 boot chain: U-Boot, DTBs, config.txt. A bare commit SHA, because the repo has no tags.
SBCOVERLAY_VERSION="7d04484be2beb4b1fca56538d2b6d07e7d58681f"

## Digest-pinned system extensions baked into the installer.
# renovate: datasource=docker
ISCSI_EXT="ghcr.io/siderolabs/iscsi-tools:v0.2.0@sha256:c1eca91fb4458ce0c50e6e36968b325ab5b3e5a554b3ad0426795efec4f2a3d5"
# renovate: datasource=docker
UTIL_EXT="ghcr.io/siderolabs/util-linux-tools:2.42.4@sha256:f7fac0baf758b7f1c19c779c95ac47e9a0c89b69e93b1849cfccdb7fb01e54ba"
